+                        )
+                        db.execSQL("DROP TABLE measurements")
+                        db.execSQL("ALTER TABLE measurements_new RENAME TO measurements")
+                        db.execSQL(
+                            "CREATE INDEX IF NOT EXISTS index_measurements_epochDay ON measurements (epochDay)"
+                        )
